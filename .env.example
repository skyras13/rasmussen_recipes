# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string. Matches the docker-compose service by default.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rasmussen_recipes"

# Session token signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Where uploaded recipe images are stored (mount a volume in production).
UPLOAD_DIR="./uploads"

# Public URL of the app, used for share-link previews.
APP_URL="http://localhost:3000"

# Optional: enables the AI features (recipe-card scanning, AI URL import,
# natural-language search). Without it those features degrade gracefully.
# ANTHROPIC_API_KEY="sk-ant-..."
